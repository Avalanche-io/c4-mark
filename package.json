{
  "name": "@avalanche-io/c4-mark",
  "version": "0.1.0",
  "description": "A C4 ID (SMPTE ST 2114) drawn as a small mark: the c4 logo in corner brackets, with optional glyphs from the SHA-512 digest. Zero dependencies.",
  "type": "module",
  "main": "./c4mark.js",
  "exports": {
    ".": "./c4mark.js",
    "./element": "./element.js",
    "./style.css": "./c4mark.css"
  },
  "files": [
    "c4mark.js",
    "element.js",
    "c4mark.css",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "./element.js",
    "*.css"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs && go test ./..."
  },
  "keywords": [
    "c4",
    "c4id",
    "smpte-st-2114",
    "content-addressing",
    "sha-512",
    "web-component",
    "identicon"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "Joshua Ian Kolden",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avalanche-io/c4-mark.git"
  }
}
